# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Shared by apps/admin and apps/forms via packages/db (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadmagnet"

# (세션 서명 비밀키는 없습니다 — 세션 쿠키에는 무작위 토큰만 담고 DB 에 해시를 저장합니다. ADR-0001)

# ─── Origins ──────────────────────────────────────────────────────────
# Admin and public forms MUST be served from different origins
# so uploaded HTML can never reach the admin session/API (see docs/adr/0001).
ADMIN_ORIGIN="http://localhost:3000"
FORMS_ORIGIN="http://localhost:3001"

# ─── Seed operator (used by `pnpm db:seed`) ───────────────────────────
SEED_OPERATOR_EMAIL="admin@example.com"
SEED_OPERATOR_PASSWORD="admin1234!"

# ─── Tests ────────────────────────────────────────────────────────────
# 테스트는 별도 DB 를 사용합니다 (시작 시 자동 마이그레이션, 각 테스트 전 TRUNCATE)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadmagnet_test"
