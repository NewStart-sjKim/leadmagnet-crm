{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "ADMIN_ORIGIN",
    "FORMS_ORIGIN",
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    }
  }
}
