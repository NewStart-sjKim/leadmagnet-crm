{
  "name": "leadmagnet-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 && playwright test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @leadmagnet/db migrate:dev",
    "db:deploy": "pnpm --filter @leadmagnet/db migrate:deploy",
    "db:seed": "pnpm --filter @leadmagnet/db seed",
    "db:generate": "pnpm --filter @leadmagnet/db generate",
    "test:unit": "turbo run test --concurrency=1"
  },
  "devDependencies": {
    "@leadmagnet/db": "workspace:*",
    "@playwright/test": "1.63.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "postcss": "^8.5.28",
      "prisma": "-",
      "@prisma/client": "-"
    }
  }
}
